# Bu dosyayi ".env" adiyla kopyalayin ve anahtari yapistirin.
# .env depoya girmez (.gitignore icinde).
# Pexels (b-roll klipleri): https://www.pexels.com/api/ -- ucretsiz, aninda verilir.
PEXELS_API_KEY=

# YouTube Data API v3 (konu kesfi): https://console.cloud.google.com/apis/credentials
# Once "YouTube Data API v3" etkinlestirilir, sonra API anahtari olusturulur.
YOUTUBE_API_KEY=

# YouTube yukleme (OAuth client ID > Desktop app). Izin icin bir kere:
#   node scripts/upload.mjs --login
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
